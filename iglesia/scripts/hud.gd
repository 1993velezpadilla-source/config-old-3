extends CanvasLayer
## Screen-space 2D source frames, official PNG buttons; new native touch implementation.
var player
var game
var root: Control
var life_label: Label
var ammo_label: Label
var round_label: Label
var notice_label: Label
var crosshair: Label
var weapon: TextureRect
var joystick_base: Panel
var joystick_thumb: Panel
var buttons: Dictionary = {}  # TextureButtons: artwork fills the real touch hitboxes.
var mp40_frames: Dictionary = {}
var joystick_id: int = -1
var origin: Vector2 = Vector2.ZERO
var stick: Vector2 = Vector2.ZERO
var notice_clock: float = 0.0
var hit_clock: float = 0.0
var hurt_overlay: ColorRect
var last_frame: String = ""

func _ready() -> void:
    root = Control.new()
    root.name = "TouchCanvas"
    root.mouse_filter = Control.MOUSE_FILTER_IGNORE
    root.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    add_child(root)
    hurt_overlay = ColorRect.new()
    hurt_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
    hurt_overlay.color = Color(0.85, 0.0, 0.0, 0.0)
    root.add_child(hurt_overlay)
    weapon = TextureRect.new()
    weapon.name = "ApprovedMP40_2DPixelView"
    weapon.mouse_filter = Control.MOUSE_FILTER_IGNORE
    weapon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
    weapon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
    root.add_child(weapon)
    var nun_palette := ShaderMaterial.new()
    nun_palette.shader = preload("res://shaders/nun_viewmodel_gothic_ink.gdshader")
    weapon.material = nun_palette
    for frame_name in ["idle_hip_01", "ads_idle", "fire_hip_01", "ads_fire_01",
        "sprint_01", "reload_01", "reload_02", "reload_03", "reload_04"]:
        var path: String = "res://assets/weapons/mp40/%s.png" % frame_name
        if ResourceLoader.exists(path):
            mp40_frames[frame_name] = load(path)
    if mp40_frames.size() != 9:
        push_warning("IGLESIA_PIXEL_WEAPON_ART_PENDING: 9 high-res PNG frames required")
    life_label = _label("VIDA", 29)
    ammo_label = _label("MP40", 29)
    round_label = _label("RONDA", 31)
    notice_label = _label("", 34)
    crosshair = _label("+", 30)
    crosshair.add_theme_color_override("font_color", Color(1, 1, 1, 0.8))
    joystick_base = _circle(Color(0.7, 0.7, 0.7, 0.18), 120)
    joystick_thumb = _circle(Color(0.91, 0.91, 0.91, 0.48), 53)
    # Artwork source: exact approved PNG skins, not old autogenerated circles/SVGs.
    _button("fire", "fire.png", Vector2(0.885, 0.56), 116)
    _button("ads", "aim.png", Vector2(0.765, 0.43), 101)
    _button("reload", "reload.png", Vector2(0.90, 0.78), 86)
    _button("jump", "vault_jump.png", Vector2(0.77, 0.79), 84)
    _button("slide", "slide.png", Vector2(0.66, 0.86), 75)
    _button("interact", "interact.png", Vector2(0.66, 0.62), 84)
    get_viewport().size_changed.connect(_layout)
    _layout()

func _label(text_value: String, font_size: int) -> Label:
    var label := Label.new()
    label.text = text_value
    label.add_theme_font_size_override("font_size", font_size)
    label.add_theme_color_override("font_color", Color(0.95, 0.91, 0.84))
    label.mouse_filter = Control.MOUSE_FILTER_IGNORE
    root.add_child(label)
    return label

func _circle(color: Color, diameter: float) -> Panel:
    var panel := Panel.new()
    panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
    panel.size = Vector2.ONE * diameter
    var style := StyleBoxFlat.new()
    style.bg_color = color
    style.corner_radius_top_left = int(diameter / 2.0)
    style.corner_radius_top_right = int(diameter / 2.0)
    style.corner_radius_bottom_left = int(diameter / 2.0)
    style.corner_radius_bottom_right = int(diameter / 2.0)
    panel.add_theme_stylebox_override("panel", style)
    root.add_child(panel)
    return panel

func _button(action: String, art: String, relative: Vector2, dimension: float) -> void:
    # Unlike a flat Button.icon, TextureButton draws the entire supplied
    # official PNG across a predictable hit rectangle on Android/Fold.
    # NEVER synthesize a different skin or turn arbitrary camera taps into fire.
    var button := TextureButton.new()
    button.name = "Official_" + action
    button.focus_mode = Control.FOCUS_NONE
    button.mouse_filter = Control.MOUSE_FILTER_STOP
    button.ignore_texture_size = true
    button.stretch_mode = TextureButton.STRETCH_KEEP_ASPECT_CENTERED
    button.size = Vector2.ONE * dimension
    button.modulate = Color(1, 1, 1, 0.88)
    button.z_index = 20
    button.action_mode = BaseButton.ACTION_MODE_BUTTON_PRESS
    var source: String = "res://assets/hud/" + art
    if ResourceLoader.exists(source):
        button.texture_normal = load(source)
        button.texture_pressed = button.texture_normal
        button.texture_hover = button.texture_normal
        button.texture_disabled = button.texture_normal
    else:
        # Textual emergency fallback is an interactive TOUCH target, not a
        # replacement PNG. CI requires every approved source to exist.
        var fallback := Label.new()
        fallback.name = "MissingOfficialArtwork"
        fallback.text = action.to_upper()
        fallback.mouse_filter = Control.MOUSE_FILTER_IGNORE
        fallback.set_anchors_and_offsets_preset(Control.PRESET_CENTER)
        button.add_child(fallback)
        push_warning("IGLESIA_HUD_APPROVED_BUTTON_MISSING: " + source)
    button.button_down.connect(_press_action.bind(action))
    button.button_up.connect(_release_action.bind(action))
    button.set_meta("relative", relative)
    button.set_meta("dimension", dimension)
    root.add_child(button)
    buttons[action] = button

func _press_action(action: String) -> void:
    if action == "ads" and player != null and player.ads_toggle_mode:
        player.toggle_ads()
    elif action == "interact" and game != null:
        game.buy_wall_ammo()
    else:
        Input.action_press(action)

func _release_action(action: String) -> void:
    if action == "ads" and player != null and player.ads_toggle_mode:
        return
    if action == "interact":
        return
    Input.action_release(action)

func _layout(screen_override: Vector2 = Vector2.ZERO) -> void:
    # Supports headless QA against folded and unfolded mobile aspect ratios.
    var screen: Vector2 = screen_override if screen_override.x > 0.0 else get_viewport().get_visible_rect().size
    root.size = screen
    hurt_overlay.size = screen
    var s: float = clampf(screen.y / 720.0, 0.62, 1.7)
    life_label.position = Vector2(20, 20) * s
    ammo_label.position = Vector2(screen.x - 250 * s, screen.y - 100 * s)
    round_label.position = Vector2(20 * s, screen.y - 110 * s)
    notice_label.position = Vector2(screen.x * 0.37, 25 * s)
    crosshair.position = screen * 0.5 - Vector2(9, 18) * s
    weapon.size = Vector2(550, 360) * s
    weapon.position = Vector2(screen.x / 2 - weapon.size.x / 2,
        screen.y - weapon.size.y + 25 * s)
    if joystick_id < 0:
        origin = Vector2(screen.x * 0.17, screen.y * 0.77)
    joystick_base.size = Vector2.ONE * 120 * s
    joystick_thumb.size = Vector2.ONE * 53 * s
    _stick_positions(s)
    for action in buttons:
        var btn: TextureButton = buttons[action]
        var relative: Vector2 = btn.get_meta("relative")
        var diameter: float = float(btn.get_meta("dimension")) * s
        btn.size = Vector2.ONE * diameter
        var center: Vector2 = screen * relative
        btn.position = Vector2(
            clampf(center.x - diameter * 0.5, 8.0, maxf(8.0, screen.x - diameter - 8.0)),
            clampf(center.y - diameter * 0.5, 8.0, maxf(8.0, screen.y - diameter - 8.0))
        )
        btn.visible = true

func _stick_positions(s: float) -> void:
    joystick_base.position = origin - joystick_base.size / 2.0
    joystick_thumb.position = origin + stick * 49.0 * s - joystick_thumb.size / 2.0

func _input(event: InputEvent) -> void:
    var screen: Vector2 = get_viewport().get_visible_rect().size
    if event is InputEventScreenTouch:
        var e := event as InputEventScreenTouch
        if e.pressed and joystick_id == -1 and e.position.x < screen.x * 0.44 and e.position.y > screen.y * 0.3:
            joystick_id = e.index
            origin = e.position
            stick = Vector2.ZERO
            _stick_positions(screen.y / 720.0)
        elif not e.pressed and e.index == joystick_id:
            joystick_id = -1
            stick = Vector2.ZERO
            origin = Vector2(screen.x * 0.17, screen.y * 0.77)
            _stick_positions(screen.y / 720.0)
    elif event is InputEventScreenDrag:
        var d := event as InputEventScreenDrag
        if d.index == joystick_id:
            stick = ((d.position - origin) / (72.0 * screen.y / 720.0)).limit_length(1.0)
            _stick_positions(screen.y / 720.0)
        elif d.position.x > screen.x * 0.44 and player != null:
            # Dragging while holding FIRE still moves camera; separate touch ID.
            player.look_delta(d.relative)

func get_move_axis() -> Vector2:
    return stick

func update_stats(health: int, magazine: int, reserve: int, round_no: int, points: int, reloading: bool) -> void:
    life_label.text = "VIDA  %d" % health
    ammo_label.text = "%02d / %03d%s" % [magazine, reserve, "  RECARGANDO" if reloading else ""]
    round_label.text = "RONDA %d     %d PTS" % [round_no, points]

func show_notice(msg: String) -> void:
    notice_label.text = msg
    notice_clock = 2.6

func weapon_shot() -> void:
    last_frame = ""  # force refresh, fire state determined by player.shot_flash

func flash_hurt() -> void:
    hit_clock = 0.35

func _process(delta: float) -> void:
    notice_clock = maxf(0.0, notice_clock - delta)
    if notice_clock == 0.0:
        notice_label.text = ""
    hit_clock = maxf(0.0, hit_clock - delta)
    hurt_overlay.color.a = hit_clock * 0.55
    if player == null:
        return
    var ads: bool = player.ads_active()
    crosshair.visible = not ads
    var frame: String = "ads_idle" if ads else "idle_hip_01"
    if player.reload_active:
        var stage: int = clampi(4 - int(ceil(player.reload_left / (player.reload_seconds / 4.0))), 0, 3)
        frame = "reload_0%d" % (stage + 1)
    elif player.shot_flash > 0.0:
        frame = "ads_fire_01" if ads else "fire_hip_01"
    elif Input.is_action_pressed("sprint") and not ads:
        frame = "sprint_01"
    if frame != last_frame:
        weapon.texture = mp40_frames.get(frame, null)
        last_frame = frame
    var screen: Vector2 = get_viewport().get_visible_rect().size
    var s: float = screen.y / 720.0
    var zoom: float = 1.08 if ads else 1.0
    weapon.size = Vector2(550, 360) * s * zoom
    weapon.position = Vector2(screen.x * 0.5 - weapon.size.x * 0.5,
        screen.y - weapon.size.y + 25.0 * s)
