{
  "schema_version": 1,
  "policy": {
    "manager": "conda-prefix",
    "purpose": "isolate incompatible Torch/CUDA stacks per Hayuya backend",
    "notes": [
      "These are Hayuya runtime environment choices derived from the pinned upstream installation instructions.",
      "A modern NVIDIA driver may run older CUDA runtime wheels, but native extension compilation still requires a compatible local CUDA toolkit.",
      "TRELLIS and TRELLIS.2 use their pinned upstream setup.sh inside an isolated conda prefix.",
      "Restricted/community-license backends are intentionally excluded from automatic environment setup."
    ]
  },
  "backends": {
    "triposg": {
      "python": "3.10",
      "strategy": "pip_requirements",
      "torch": {
        "version": "2.4.1",
        "torchvision": "0.19.1",
        "index_url": "https://download.pytorch.org/whl/cu121",
        "cuda_family": "12.1",
        "selection": "HAYUYA compatibility choice; upstream allows selecting the correct CUDA PyTorch build"
      },
      "requirements": "requirements.txt"
    },
    "triposf": {
      "python": "3.10",
      "strategy": "pip_requirements",
      "torch": {
        "version": "2.4.1",
        "torchvision": "0.19.1",
        "index_url": "https://download.pytorch.org/whl/cu121",
        "cuda_family": "12.1",
        "selection": "HAYUYA compatibility choice; upstream requires PyTorch 2.0+"
      },
      "requirements": "requirements.txt"
    },
    "trellis2": {
      "python": "3.10",
      "strategy": "upstream_setup",
      "torch": {
        "version": "2.6.0",
        "torchvision": "0.21.0",
        "index_url": "https://download.pytorch.org/whl/cu124",
        "cuda_family": "12.4",
        "selection": "matches pinned upstream setup.sh default"
      },
      "setup_flags": [
        "--basic",
        "--flash-attn",
        "--nvdiffrast",
        "--nvdiffrec",
        "--cumesh",
        "--o-voxel",
        "--flexgemm"
      ],
      "cuda_home_hint": "/usr/local/cuda-12.4"
    },
    "trellis": {
      "python": "3.10",
      "strategy": "upstream_setup",
      "torch": {
        "version": "2.4.0",
        "torchvision": "0.19.0",
        "index_url": "https://download.pytorch.org/whl/cu121",
        "cuda_family": "12.1",
        "selection": "pinned upstream supports Torch 2.4.0 and CUDA 12.x; Hayuya uses cu121 for InstantMesh compatibility"
      },
      "setup_flags": [
        "--basic",
        "--xformers",
        "--flash-attn",
        "--diffoctreerast",
        "--spconv",
        "--mipgaussian",
        "--kaolin",
        "--nvdiffrast"
      ],
      "cuda_home_hint": "/usr/local/cuda-12.1"
    },
    "instantmesh": {
      "python": "3.10",
      "strategy": "pip_requirements",
      "torch": {
        "version": "2.1.0",
        "torchvision": "0.16.0",
        "torchaudio": "2.1.0",
        "index_url": "https://download.pytorch.org/whl/cu121",
        "cuda_family": "12.1",
        "selection": "matches pinned upstream README"
      },
      "pre_pip": [
        "xformers==0.0.22.post7"
      ],
      "requirements": "requirements.txt"
    },
    "triposr": {
      "python": "3.10",
      "strategy": "pip_requirements",
      "torch": {
        "version": "2.1.0",
        "torchvision": "0.16.0",
        "index_url": "https://download.pytorch.org/whl/cu121",
        "cuda_family": "12.1",
        "selection": "HAYUYA compatibility choice; upstream requires matching local CUDA/PyTorch major"
      },
      "requirements": "requirements.txt"
    },
    "wonder3d": {
      "python": "3.8",
      "strategy": "pip_requirements",
      "torch": {
        "version": "1.13.1",
        "torchvision": "0.14.1",
        "index_url": "https://download.pytorch.org/whl/cu117",
        "cuda_family": "11.7",
        "selection": "matches pinned upstream requirements.txt"
      },
      "requirements": "requirements.txt",
      "requirements_include_torch": true
    },
    "dinov2": {
      "python": "3.9",
      "strategy": "minimal_pip",
      "torch": {
        "version": "2.0.0",
        "torchvision": "0.15.0",
        "index_url": "https://download.pytorch.org/whl/cu117",
        "cuda_family": "11.7",
        "selection": "matches pinned upstream conda.yaml/requirements.txt"
      },
      "pip": [
        "omegaconf",
        "torchmetrics==0.10.3",
        "fvcore",
        "iopath"
      ],
      "notes": "Judge only needs the classic backbone path; training/cuml dependencies are intentionally omitted."
    },
    "judge_v4": {
      "python": "3.11",
      "strategy": "minimal_pip",
      "source_required": false,
      "torch": {
        "version": "2.6.0",
        "torchvision": "0.21.0",
        "index_url": "https://download.pytorch.org/whl/cu124",
        "cuda_family": "12.4",
        "selection": "HAYUYA Judge v4 compatibility stack for modern multimodal evaluators"
      },
      "pip": [
        "transformers>=5.2,<6",
        "accelerate>=1.6,<2",
        "safetensors>=0.5",
        "huggingface_hub>=0.30",
        "sentencepiece>=0.2",
        "einops>=0.8",
        "timm>=1.0",
        "Pillow>=10",
        "numpy>=1.26,<3",
        "mediapipe==1.0.1",
        "dreamsim",
        "pyiqa==0.1.15",
        "hydra-core==1.3.2",
        "easydict>=1.10",
        "fvcore",
        "iopath",
        "scipy>=1.11,<2",
        "qwen-vl-utils>=0.0.14",
        "uniface[gpu]>=4.0,<5"
      ],
      "notes": "Sequential worker processes unload large evaluators between passes. Final visual acceptance uses Q-ReAlign-Pro-9B, VisualQuality-R1-7B, InternVL3.5-8B-HF, MediaPipe dense landmarks, DreamSim, SigLIP2 Giant, CVLFace AdaFace WebFace12M identity, eDifFIQA-L face quality, and an Apache-licensed PyIQA 0.1.15 ensemble. Missing evidence fails closed."
    }
  }
}
