  "gui_optional": [
    {
      "name": "TrenchBroom",
      "role": "FPS blockout/entities/XZIEL level editor candidate"
    },
    {
      "name": "fSpy",
      "role": "camera solve from reference photos"
    },
    {
      "name": "BlenderGIS",
