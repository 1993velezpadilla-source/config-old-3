<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(CUE4ParseSourceRoot)' == ''">
    <PackageReference Include="CUE4Parse" Version="1.2.2.202609" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202609" />
  </ItemGroup>

  <ItemGroup Condition="'$(CUE4ParseSourceRoot)' != ''">
    <ProjectReference Include="$(CUE4ParseSourceRoot)/CUE4Parse/CUE4Parse.csproj"
                      AdditionalProperties="CUE4PARSE_SKIP_NATIVE=true;TreatWarningsAsErrors=false;WarningsAsErrors="
                      GlobalPropertiesToRemove="TreatWarningsAsErrors;WarningsAsErrors" />
    <ProjectReference Include="$(CUE4ParseSourceRoot)/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj"
                      AdditionalProperties="CUE4PARSE_SKIP_NATIVE=true;TreatWarningsAsErrors=false;WarningsAsErrors="
                      GlobalPropertiesToRemove="TreatWarningsAsErrors;WarningsAsErrors" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../common/XzielSkeletonIdentity.cs"
             Link="XzielSkeletonIdentity.cs" />
  </ItemGroup>
</Project>
