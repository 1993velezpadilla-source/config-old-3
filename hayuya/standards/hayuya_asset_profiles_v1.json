        "skeletal",
        "morph_targets",
        "secondary_motion"
      ],
      "preferred_pipeline": [
        "multiview_if_available",
        "retopo",
        "pbr_texture",
        "humanoid_autorig",
        "face_controls",
        "deformation_qa"
      ],
      "required_qa": [
        "mesh_gate",
        "texture_clarity",
        "rig_gate",
        "deformation_gate"
      ]
    },
